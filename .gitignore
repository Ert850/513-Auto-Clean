# ---------------------------------------------------------------
# Secrets. NEVER commit these.
# .env.local holds SHOP_ORIGIN_* (Elijah's home address), Stripe
# secret keys, the Google service-account JSON, and Twilio creds.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*-service-account*.json
gcp-credentials*.json

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output (dist/ is what Netlify publishes; it is assembled by the build)
.next/
out/
build/
dist/
.vercel
.netlify

# Test / coverage
coverage/
*.lcov

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp

# Local scratch
*.local
tmp/

# Generated by web/scripts/render-config.mjs from js/config.template.js and
# the environment. Holds publishable keys, which are public but still have no
# business being committed: keeping them out means Netlify secret scanning has
# nothing to argue with, and a Deploy Preview can carry different keys from
# production.
js/config.js

# Content studio: video concepts, niche research, scripts. Separate from the
# website and never published. Kept beside it only so the catalog, prices and
# service copy are one directory away when writing.
content/

# Lighthouse build plugin output. Written at the repo root, outside dist/,
# so it is never published; it does not belong in the repo either.
/reports/
