{
  "name": "513-auto-clean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:funnel": "esbuild lib/browser-entry.ts --bundle --format=iife --target=es2018 --minify --outfile=../js/pricing.bundle.js",
    "build:funnel:dev": "esbuild lib/browser-entry.ts --bundle --format=iife --target=es2018 --sourcemap --outfile=../js/pricing.bundle.js",
    "build:server": "esbuild lib/server-entry.ts --bundle --format=esm --platform=node --target=node20 --outfile=../netlify/functions/_pricing.mjs",
    "build:site": "node scripts/render-site.mjs",
    "build:stamp": "node scripts/stamp-assets.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "lock:legal": "node scripts/lock-legal.mjs",
    "build:legal": "node scripts/render-legal.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
