# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Shop origin (PRIVATE) -------------------------------------------------
# Elijah's home/shop address, used only as the origin for drive-time lookups.
# Server-side only. Must NEVER be sent to the browser or appear in any
# NEXT_PUBLIC_* variable. The client sends a destination place_id and receives
# back only { driveMinutes, feeCents } — never the origin.
SHOP_ORIGIN_ADDRESS=
SHOP_ORIGIN_PLACE_ID=

# --- Google ----------------------------------------------------------------
# Server key: Routes API. Restrict by IP.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Places Autocomplete only. Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Service account with access to both calendars (read on Availability,
# write on Booked Jobs). Paste the JSON as a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_AVAILABILITY_ID=
GOOGLE_CALENDAR_BOOKED_ID=

# --- Database --------------------------------------------------------------
# Neon. Use the POOLED string here; the direct one only for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications ---------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=

# --- Admin auth ------------------------------------------------------------
# argon2id hash of the admin password — generate locally, never store plaintext.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=
